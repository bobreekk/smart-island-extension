{
  "manifest_version": 3,
  "name": "Smart Island Extension",
  "version": "2.0",
  "description": "Smart Island widget for browser",
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}